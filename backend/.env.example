# Claude API Configuration
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Origins (comma-separated)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Model Configuration (optional - defaults to Claude 3.5 Sonnet)
# Vision model for transcribing handwritten algebra
VISION_MODEL=claude-3-5-sonnet-20241022

# Coaching model for Socratic feedback
COACH_MODEL=claude-3-5-sonnet-20241022

# Deployment Environment
# Set to 'production' in production environments
ENVIRONMENT=development

# Database Configuration (optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost/algebra_coach
